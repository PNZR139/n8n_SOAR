# Copy this file to .env and fill in values.

# --- Postgres (also used by n8n and the app) ---
POSTGRES_USER=soar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=soar

# --- n8n ---
# MUST be set to a long random string before first boot (encrypts stored credentials).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# --- App ---
# Base URL the app uses to trigger n8n playbook webhooks.
# Use http://n8n:5678/webhook inside docker; http://localhost:5678/webhook when running app on host.
N8N_WEBHOOK_BASE=http://n8n:5678/webhook

# Tenant id stamped on every record (multi-tenant readiness).
DEFAULT_TENANT=default
