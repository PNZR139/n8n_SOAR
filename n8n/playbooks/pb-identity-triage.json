      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Build the triage note from the incident payload and (optional) enrichment.\nconst hook = $('Webhook').first().json.body;\nconst ev = hook.event || {};\nconst input = $input.first().json;\n\n// Input is the VirusTotal response when the enrichment branch ran,\n// or the Create Case response ({ id }) when it was skipped.\nconst enrichedBranch = 'ok' in input || 'error' in input;\n\nlet enrichment;\nlet verdict = '';\nif (!enrichedBranch) {\n  enrichment = 'Skipped (event has no src_ip)';\n} else if (input.ok === true) {\n  const attrs = (input.data && input.data.data && input.data.data.attributes) || {};\n  const s = attrs.last_analysis_stats || {};\n  enrichment =\n    'malicious=' + (s.malicious ?? '?') +\n    ', suspicious=' + (s.suspicious ?? '?') +\n    ', harmless=' + (s.harmless ?? '?') +\n    ' | owner: ' + (attrs.as_owner || 'n/a') +\n    ' | country: ' + (attrs.country || 'n/a');\n  if ((s.malicious || 0) > 0) {\n    verdict = 'Source IP is flagged malicious by ' + s.malicious + ' VirusTotal engine(s).';\n  }\n} else {\n  const err = input.error;\n  const msg = typeof err === 'string' ? err : ((err && err.message) || JSON.stringify(err || 'unknown error'));\n  enrichment = 'Unavailable (' + msg + ')';\n}\n\nconst lines = [\n  'Automated triage by playbook pb-identity-triage',\n  'Rule: ' + hook.rule + ' | Incident: ' + hook.incident_id,\n  'Target user: ' + (ev.target_user || 'n/a'),\n  'Source IP: ' + (ev.src_ip || 'n/a'),\n  'Event source: ' + (ev.source || 'n/a') + ' | Occurred: ' + (ev.occurred_at || 'n/a'),\n  'VirusTotal: ' + enrichment,\n];\nif (verdict) lines.push(verdict);\n\nreturn [{ json: { note: lines.join('\\n') } }];\n"
      },
      "name": "Build Note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://app:3000/cases/' + $('Create Case').first().json.id + '/notes' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ author: 'n8n', body: $json.note }) }}",
        "options": {
